{
  "name": "treasure-tide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src server tests",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -k -n server,web \"npm:server\" \"npm:dev\"",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "express": "^5.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
