# Optional: exact frontend address phones can reach. Never use localhost here.
# Copy to .env, uncomment and replace with YOUR Vite Network URL; then restart.
# Use a plain URL, never Markdown [url](url). This setting only changes share links.
# VITE_PUBLIC_GAME_URL=http://YOUR_LAN_IP:5173

# Empty uses the page origin; Vite proxies Socket.IO to PORT below.
VITE_SOCKET_URL=
PORT=3001

# Required in production; comma-separated exact frontend origins, no wildcard.
# FRONTEND_ORIGIN=https://pirategame.example.com
# NODE_ENV=production

# Authoritative local persistence (contains host hashes and join tokens).
GAME_STATE_FILE=server/data/games.json
